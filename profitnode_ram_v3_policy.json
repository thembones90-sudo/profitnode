  "catalogName": "PROFITNODE RAM V3",
  "scope": "Desktop consumer DDR4/DDR5 UDIMM plus modern DDR5 CUDIMM-aware configuration scoring.",
  "method": {
    "formula": "35% capacity + 30% bandwidth + 20% true CAS latency + 15% DIMM topology",
    "capacityWeight": 0.35,
    "bandwidthWeight": 0.3,
    "latencyWeight": 0.2,
    "topologyWeight": 0.15,
    "notes": [
      "Brand, RGB, heatspreader design and price do not affect performance score.",
      "Configured MT/s is treated as achieved memory data rate.",
      "CAS latency is converted to true latency using CL*2000/MT_s.",
      "Four-DIMM DDR5 configurations receive a larger topology penalty than four-DIMM DDR4.",
      "XMP/EXPO availability is metadata and does not directly add performance points."
    ]
  },
